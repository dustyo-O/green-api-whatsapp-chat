{
  "ticket_prefix": "TKT",
  "tracker": {
    "kind": "linear",
    "team": "TKT",
    "labels": {
      "bug": "Bug",
      "idea": "Improvement",
      "feature": "Feature"
    }
  },
  "review": {
    "reviewer": "codex",
    "effort": "low",
    "context": [
      "context/product/product-definition.md",
      "context/product/architecture.md"
    ]
  },
  "lanes": {
    "react-frontend": {
      "owns": [
        "./"
      ],
      "gate": "npm run check"
    }
  },
  "commit_format": "<type>(<scope>): <what>\n\nRefs: {ticket} s{slice}/{lane}"
}
